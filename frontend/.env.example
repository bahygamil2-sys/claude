# Copy this file to .env and adjust as needed.

# Get your own key from https://console.cloud.google.com/google/maps-apis
# (enable "Maps JavaScript API"). Without a real key, the order-tracking page
# still works but shows a fallback panel instead of the live map — see README.
VITE_GOOGLE_MAPS_API_KEY=

# Leave empty in local dev — Vite's dev server proxies /api and /socket.io to
# the backend (see vite.config.ts), so relative URLs are used by default.
VITE_API_BASE_URL=
