generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

// ---------------------------------------------------------------------------
// Org structure
// ---------------------------------------------------------------------------

model Brand {
  id        String   @id @default(cuid())
  name      String
  nameAr    String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAccess UserBrandAccess[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               UserRole
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?

  brandAccess   UserBrandAccess[]
  refreshTokens RefreshToken[]

  @@index([isActive])
}

// Non-admin scoping: a row here grants an EDITOR/VIEWER access to one brand
// (and everything under it). ADMIN needs no rows — global by role.
model UserBrandAccess {
  id        String   @id @default(cuid())
  userId    String
  brandId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
