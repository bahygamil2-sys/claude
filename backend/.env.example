# Copy this file to .env and adjust as needed.

NODE_ENV=development
PORT=4000

# Postgres connection. If using docker-compose (docker-compose.yml at repo root),
# this matches the postgres service defined there. If using a local Postgres
# install instead, point this at that instance.
DATABASE_URL="postgresql://bsd:bsd_dev_password@localhost:5432/bsd"

# Frontend origin allowed to call this API with credentials (cookies).
CORS_ORIGIN="http://localhost:5173"

# JWT signing secrets — generate real random values for anything beyond local dev,
# e.g. `openssl rand -base64 48`. These example values are NOT secure.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Local dev storage for uploaded workbooks (see CLAUDE.md — revisit before
# deploying anywhere with an ephemeral filesystem).
UPLOAD_DIR="./uploads"
