# Copy this file to .env and adjust as needed.

NODE_ENV=development
PORT=4000

# Postgres connection. If using docker-compose (docker-compose.yml at repo root),
# this matches the postgres service defined there. If using a local Postgres
# install instead, point this at that instance.
DATABASE_URL="postgresql://rai:rai_dev_password@localhost:5432/rai"

# Frontend origin allowed to call this API with credentials (cookies).
CORS_ORIGIN="http://localhost:5173"

# JWT signing secrets — generate real random values for anything beyond local dev,
# e.g. `openssl rand -base64 48`. These example values are NOT secure.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Base URL the public survey-taking link is built from (frontend origin, since
# /r/:token is served by the frontend app, not this API directly).
PUBLIC_SURVEY_BASE_URL="http://localhost:5173"
